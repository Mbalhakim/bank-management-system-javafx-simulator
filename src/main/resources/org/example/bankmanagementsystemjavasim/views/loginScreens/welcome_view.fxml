<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Updated to use modern styling for a professional look -->
<AnchorPane prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #ecf0f1;"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.bankmanagementsystemjavasim.controllers.WelcomeController">
    <children>
        <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" spacing="25.0">
            <children>
                <Label text="Bank Management System" textFill="#2c3e50">
                    <font>
                        <Font name="Arial Bold" size="30.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="30.0" />
                    </VBox.margin>
                </Label>


                <Button fx:id="customerLoginButton" mnemonicParsing="false" onAction="#handleCustomerLogin"
                        prefHeight="60.0" prefWidth="350.0" text="Customer Login">
                    <font>
                        <Font name="Arial" size="20.0" />
                    </font>
                    <style>
                        -fx-background-color: #3498db;
                        -fx-text-fill: white;
                        -fx-background-radius: 10;
                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);
                        -fx-cursor: hand;
                    </style>
                </Button>


                <Button fx:id="clerkLoginButton" mnemonicParsing="false" onAction="#handleClerkLogin"
                        prefHeight="60.0" prefWidth="350.0" text="Clerk Login">
                    <font>
                        <Font name="Arial" size="20.0" />
                    </font>
                    <style>
                        -fx-background-color: #1abc9c;
                        -fx-text-fill: white;
                        -fx-background-radius: 10;
                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);
                        -fx-cursor: hand;
                    </style>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
            </children>
            <padding>
                <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane>